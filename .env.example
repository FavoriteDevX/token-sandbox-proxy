# Proxy Server Configuration
PORT=3000

# Where the proxy should forward the cleaned requests
SANDBOX_TARGET_URL=https://example.com

# Mock/Sandbox Token replacement configurations
# If a live token is found, it will be automatically swapped out for this safe sandbox token
MOCK_BEARER_TOKEN=sb_bearer_token_xyz123
MOCK_API_KEY=sb_apikey_safe_environment_key
